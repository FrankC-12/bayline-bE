# App
APP_NAME=Bayline API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
POSTGRES_USER=bayline
POSTGRES_PASSWORD=bayline_dev_password
POSTGRES_DB=bayline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bayline:bayline_dev_password@localhost:5432/bayline

# Security (se termina de definir en el módulo de auth)
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Initial Platform seed user
PLATFORM_ADMIN_EMAIL=admin@bayline.com
PLATFORM_ADMIN_PASSWORD=change-this-password


# Exact frontend origins; production requires HTTPS and DEBUG=false.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Mobile notifications (disabled until Firebase credentials are configured).
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=
# Private pickup evidence uses this directory when no private S3 bucket is configured.
PRIVATE_UPLOADS_DIR=private-uploads
S3_PRIVATE_BUCKET_NAME=
# Set to the storage's actual environment to catch cross-environment uploads.
UPLOADS_ENVIRONMENT=development
