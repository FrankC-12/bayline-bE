DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
POSTGRES_USER=bayline
POSTGRES_DB=bayline
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# URL-encode password characters if necessary; hostname is the Compose service.
DATABASE_URL=postgresql+asyncpg://bayline:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/bayline
SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Acceso: motrixadmin o el correo configurado. Se crea mediante seed_platform_user.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD

# Rate limiting; PostgreSQL migration e6f931ca2d54 is required.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=1200
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_ANONYMOUS_PER_MINUTE=120
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=30

# Optional — uploads fall back to local disk (uploads/) when S3_BUCKET_NAME
# is unset. IAM user policy should be scoped to s3:PutObject/GetObject/
# DeleteObject on arn:aws:s3:::<bucket>/* only, and the bucket needs a
# public-read bucket policy (not ACLs — "Bucket owner enforced" disables
# those by default on a new bucket).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Bitácora JSON diaria (volumen backend_logs en Compose).
LOGS_DIR=/app/logs
LOGS_TIMEZONE=America/Caracas

# Optional mobile notifications: put the service account file in deploy/secrets/.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json
# Private evidence only: a DIFFERENT bucket with S3 Block Public Access enabled.
S3_PRIVATE_BUCKET_NAME=
